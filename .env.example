# -----------------------------------------------------------------------------
# CarrierPay environment configuration
#
# Copy this file to `.env` and adjust as needed. All values are optional; the
# defaults below are used when the corresponding variable is unset.
#
# The SQLite database lives at storage/database/carrierpay.db by default.
# -----------------------------------------------------------------------------

# Server ---------------------------------------------------------------------
NODE_ENV=development            # development | production
HOST=127.0.0.1
PORT=3001
APP_BASE_URL=http://localhost:3001
LOG_LEVEL=info

# Session --------------------------------------------------------------------
SESSION_COOKIE_NAME=carrierpay_session
SESSION_TTL_HOURS=12
# Set to true behind HTTPS in production.
SECURE_COOKIES=false

# Database -------------------------------------------------------------------
# Default: file:<repo>/storage/database/carrierpay.db
# DATABASE_URL=file:./storage/database/carrierpay.db

# Storage --------------------------------------------------------------------
# Default: <repo>/storage
# STORAGE_ROOT=./storage
# Directory for Playwright's Chromium build (paystub PDFs).
# Default: <repo>/storage/playwright
# PLAYWRIGHT_BROWSERS_PATH=./storage/playwright

# Optional email (notifications are in-app; SMTP is reserved for future use) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
